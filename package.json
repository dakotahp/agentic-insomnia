{
  "name": "cc-caffeine",
  "version": "0.5.0",
  "description": "Prevents your computer from sleeping while Claude Code works hard",
  "main": "caffeine.js",
  "bin": {
    "cc-caffeine": "./caffeine.js"
  },
  "scripts": {
    "start": "npm run server",
    "caffeinate": "node caffeine.js caffeinate",
    "uncaffeinate": "node caffeine.js uncaffeinate",
    "status": "node caffeine.js status",
    "version": "node caffeine.js version",
    "server": "npx electron caffeine.js server",
    "native-server": "node caffeine.js server",
    "test": "node --test",
    "lint": "eslint --fix *.js src/*.js test/*.js opencode/*.mjs || echo 'eslint not installed'",
    "format": "prettier --write *.js src/*.js || echo 'prettier not installed'"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "plugin",
    "nap",
    "sleep",
    "sleep-prevention",
    "caffeine",
    "caffeinate",
    "system-tray",
    "electron"
  ],
  "author": {
    "name": "Dakotah Peña",
    "email": "git@dakotahpena.dev",
    "url": "https://dakotahpena.dev"
  },
  "license": "MIT",
  "dependencies": {
    "electron": "^44.1.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "eslint": "^10.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samber/cc-caffeine.git"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
